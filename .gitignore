# Secrets and machine-specific material - never commit these.
# These patterns are deliberately aggressive. If a legitimate documentation file is
# ignored by mistake, check with `git check-ignore -v <path>` and add it with `git add -f`.
.env
.env.*
!.env.example
*.env
secrets/
*.key
*.pem
*.age
*.gpg
*.kdbx
id_rsa*
id_ed25519*
!*.pub
*authkey*
*.token
*password*
!*password*.md

# Private copies of the owner profile (real inventory belongs in a private place)
profile/*.local.*
profile/private/

# Editor / OS noise
*.swp
.DS_Store
